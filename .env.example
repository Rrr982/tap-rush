# Facebook app credentials. Never commit the real values.
FB_APP_ID=000000000000000
FB_APP_SECRET=replace-me

# Where the leaderboard API lives. The game bundle is uploaded to Facebook and
# runs from their CDN, so this has to be an absolute https URL.
VITE_API_BASE_URL=https://your-deployment.vercel.app

# Comma separated list of extra origins allowed to call the API.
CORS_ORIGINS=

# Postgres connection string (Neon). Leave empty to use the in-memory store.
DATABASE_URL=

# postgres | memory. Defaults to postgres when DATABASE_URL is set.
DB_DRIVER=

# How long a signed Facebook payload stays acceptable, in ms.
MAX_SIGNATURE_AGE_MS=600000
